# Copy to .env and set the values in your shell (or Windows "set" commands). See README.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Set HTTPS=1 only when the site is served over HTTPS (enables secure cookies).
HTTPS=0
# Leave DB_ENGINE empty for SQLite. For PostgreSQL:
# DB_ENGINE=postgres
# DB_NAME=daily_reports
# DB_USER=postgres
# DB_PASSWORD=...
# DB_HOST=127.0.0.1
# DB_PORT=5432
